# Copy this file to .env and fill in the values you need.
# EVERYTHING here is optional - with an empty .env the app runs on a temporary in-memory database
# with demo data, stores uploads in public/uploads, and uses free OpenStreetMap maps.

# MongoDB connection string. Leave empty to use the in-memory demo database.
#   Local MongoDB:  mongodb://127.0.0.1:27017/basera
#   MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/basera
MONGO_URL=

# Secret used to sign session cookies. Use any long random string.
SESSION_SECRET=384e1f76230afcc31297bdaf9893b16637b3941e844b26b2f84ddb5c9d031389

# Port the server listens on (default 8080)
PORT=8080

# Optional: Cloudinary image hosting. If CLOUD_NAME is empty, uploads are saved to public/uploads.
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
