<% layout("/layouts/boilerplate") -%>
<%
    const isCustomer = currUser && currUser.role === ROLES.CUSTOMER;
    const alreadyReviewed = currUser && listing.reviews.some((r) => r.author && r.author._id.equals(currUser._id));
%>

<div class="container mt-4">
    <!-- ===== Title ===== -->
    <h1 class="detail-title"><%= listing.title %></h1>
    <div class="d-flex flex-wrap gap-3 align-items-center mb-3">
        <% if (listing.averageRating) { %>
            <span class="fw-semibold"><i class="fa-solid fa-star"></i> <%= listing.averageRating.toFixed(1) %></span>
            <a href="#reviews" class="text-dark"><%= listing.reviews.length %> <%= listing.reviews.length === 1 ? "review" : "reviews" %></a>
        <% } else { %>
            <span class="fw-semibold"><i class="fa-solid fa-star"></i> New</span>
        <% } %>
        <span class="text-muted-ll">·</span>
        <span class="fw-semibold"><%= listing.location %>, <%= listing.country %></span>
    </div>

    <img src="<%= listing.image.url %>" alt="<%= listing.title %>" class="detail-hero-img">

    <div class="row mt-4 gx-lg-5">
        <!-- ===== Left column: details ===== -->
        <div class="col-lg-7">
            <div class="host-row">
                <span class="avatar avatar-lg"><%= listing.owner.username.charAt(0) %></span>
                <div>
                    <div class="fw-bold">Hosted by <%= listing.owner.username %></div>
                    <div class="text-muted-ll small">Hosting since <%= formatDate(listing.owner.createdAt) %></div>
                </div>
            </div>

            <div class="feature-list">
                <span class="feature-pill"><i class="<%= (CATEGORIES.find((c) => c.name === listing.category) || {}).icon %>"></i><%= listing.category %></span>
                <span class="feature-pill"><i class="fa-solid fa-user-group"></i>Up to <%= listing.maxGuests %> guests</span>
                <span class="feature-pill"><i class="fa-solid fa-calendar-check"></i>Instant booking</span>
            </div>

            <div class="py-4 border-bottom">
                <h2 class="h5 fw-bold">About this place</h2>
                <p class="mb-0" style="white-space: pre-line;"><%= listing.description || "The host hasn't added a description yet." %></p>
            </div>

            <% if (bookedRanges.length > 0) { %>
                <div class="py-4 border-bottom">
                    <h2 class="h5 fw-bold">Already booked</h2>
                    <p class="text-muted-ll small mb-2">These dates are taken - pick dates around them.</p>
                    <div class="d-flex flex-wrap gap-2">
                        <% for (const range of bookedRanges) { %>
                            <span class="feature-pill"><%= formatDate(range.checkIn) %> – <%= formatDate(range.checkOut) %></span>
                        <% } %>
                    </div>
                </div>
            <% } %>

            <% if (listing.geometry && listing.geometry.coordinates && listing.geometry.coordinates.length === 2) { %>
                <div class="py-4 border-bottom">
                    <h2 class="h5 fw-bold">Where you'll be</h2>
                    <p class="text-muted-ll"><%= listing.location %>, <%= listing.country %></p>
                    <div id="map" data-coordinates="<%= JSON.stringify(listing.geometry.coordinates) %>" data-title="<%= listing.title %>"></div>
                </div>
            <% } %>
        </div>

        <!-- ===== Right column: booking card ===== -->
        <div class="col-lg-5">
            <aside class="booking-card">
                <div class="mb-3"><span class="h4 fw-bold"><%= formatPrice(listing.price) %></span> <span class="text-muted-ll">night</span></div>

                <% if (isOwner) { %>
                    <p class="text-muted-ll">This is your listing.</p>
                    <div class="d-flex gap-2">
                        <a href="/listings/<%= listing._id %>/edit" class="btn btn-brand flex-fill"><i class="fa-solid fa-pen me-1"></i>Edit</a>
                        <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" class="flex-fill" data-confirm="Delete this listing? Its reviews and bookings will be removed too.">
                            <button class="btn btn-outline-danger w-100"><i class="fa-solid fa-trash me-1"></i>Delete</button>
                        </form>
                    </div>

                <% } else if (!currUser) { %>
                    <p class="text-muted-ll">Log in with a customer account to book this place.</p>
                    <a href="/login?role=customer" class="btn btn-brand w-100">Log in to book</a>

                <% } else if (!isCustomer) { %>
                    <p class="text-muted-ll mb-0">You're logged in as a <b>host</b>. Switch to a customer account to make bookings.</p>

                <% } else { %>
                    <form action="/bookings" method="POST" id="booking-form" class="needs-validation" novalidate
                          data-price="<%= listing.price %>" data-fee-rate="<%= SERVICE_FEE_RATE %>">
                        <input type="hidden" name="booking[listing]" value="<%= listing._id %>">
                        <div class="date-group mb-3">
                            <div class="row g-0">
                                <div class="col-6 border-end">
                                    <label for="checkIn">Check-in</label>
                                    <input id="checkIn" name="booking[checkIn]" type="date" min="<%= todayISO() %>" required data-checkin>
                                </div>
                                <div class="col-6">
                                    <label for="checkOut">Check-out</label>
                                    <input id="checkOut" name="booking[checkOut]" type="date" min="<%= todayISO() %>" required data-checkout>
                                </div>
                            </div>
                            <div class="row g-0 border-top">
                                <div class="col-12">
                                    <label for="guests">Guests</label>
                                    <select id="guests" name="booking[guests]">
                                        <% for (let n = 1; n <= listing.maxGuests; n++) { %>
                                            <option value="<%= n %>"><%= n %> <%= n === 1 ? "guest" : "guests" %></option>
                                        <% } %>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <button class="btn btn-brand w-100 py-2">Reserve</button>
                        <p class="text-center text-muted-ll small mt-2 mb-0">No payment is taken online - pay at the property</p>

                        <!-- Filled in by /js/booking.js when both dates are picked -->
                        <div class="price-breakdown mt-3 d-none" id="price-breakdown">
                            <div class="row-line"><u id="pb-nights"></u><span id="pb-subtotal"></span></div>
                            <div class="row-line"><u>Service fee (<%= SERVICE_FEE_RATE * 100 %>%)</u><span id="pb-fee"></span></div>
                            <div class="row-line total"><span>Total</span><span id="pb-total"></span></div>
                        </div>
                    </form>
                <% } %>
            </aside>
        </div>
    </div>

    <!-- ===== Reviews ===== -->
    <section id="reviews" class="mt-5 pt-4 border-top">
        <h2 class="h4 fw-bold mb-4">
            <% if (listing.averageRating) { %>
                <i class="fa-solid fa-star"></i> <%= listing.averageRating.toFixed(1) %> · <%= listing.reviews.length %> <%= listing.reviews.length === 1 ? "review" : "reviews" %>
            <% } else { %>
                No reviews yet
            <% } %>
        </h2>

        <% if (isCustomer && !alreadyReviewed) { %>
            <form action="/listings/<%= listing._id %>/reviews" method="POST" class="needs-validation mb-5" novalidate style="max-width: 640px;">
                <label class="form-label d-block">Your rating</label>
                <div class="star-input mb-3">
                    <% for (let star = 5; star >= 1; star--) { %>
                        <input type="radio" id="star<%= star %>" name="review[rating]" value="<%= star %>" <%= star === 5 ? "checked" : "" %>>
                        <label for="star<%= star %>" title="<%= star %> stars"><i class="fa-solid fa-star"></i></label>
                    <% } %>
                </div>
                <label for="comment" class="form-label">Your review</label>
                <textarea id="comment" name="review[comment]" rows="3" class="form-control mb-3" placeholder="How was your stay?" required></textarea>
                <div class="invalid-feedback">Please write a few words.</div>
                <button class="btn btn-outline-ink">Post review</button>
            </form>
        <% } %>

        <div class="row row-cols-1 row-cols-md-2 g-3">
            <% for (const review of listing.reviews) { %>
                <div class="col">
                    <div class="review-card">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="avatar"><%= review.author ? review.author.username.charAt(0) : "?" %></span>
                            <div>
                                <div class="fw-bold"><%= review.author ? review.author.username : "Deleted user" %></div>
                                <div class="text-muted-ll small"><%= formatDate(review.createdAt) %></div>
                            </div>
                        </div>
                        <div class="text-star mb-1">
                            <% for (let star = 1; star <= 5; star++) { %>
                                <i class="<%= star <= review.rating ? 'fa-solid' : 'fa-regular' %> fa-star"></i>
                            <% } %>
                        </div>
                        <p class="mb-2"><%= review.comment %></p>
                        <% if (currUser && review.author && review.author._id.equals(currUser._id)) { %>
                            <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST" data-confirm="Delete your review?">
                                <button class="btn btn-sm btn-link text-danger p-0">Delete</button>
                            </form>
                        <% } %>
                    </div>
                </div>
            <% } %>
        </div>
    </section>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="/js/map.js"></script>
<script src="/js/booking.js"></script>
