<% layout("/layouts/boilerplate") -%>
<%
    // Builds a /listings URL that keeps the current filters but changes the category.
    const linkForCategory = (name) => {
        const params = new URLSearchParams(filters);
        if (name) params.set("category", name); else params.delete("category");
        const query = params.toString();
        return query ? `/listings?${query}` : "/listings";
    };
    const hasFilters = Object.keys(filters).length > 0;
%>

<div class="container">
    <%- include("../includes/category-bar.ejs", { activeCategory: filters.category, linkFor: linkForCategory }) %>

    <!-- ===== Filters (submits as GET, so every search is a shareable URL) ===== -->
    <form class="filter-panel mt-3" action="/listings" method="GET">
        <% if (filters.category) { %><input type="hidden" name="category" value="<%= filters.category %>"><% } %>
        <div class="row g-2 align-items-end">
            <div class="col-lg-3 col-md-6">
                <label for="f-q">Where</label>
                <input id="f-q" name="q" class="form-control" placeholder="City, country or title" value="<%= filters.q || '' %>">
            </div>
            <div class="col-lg-2 col-6">
                <label for="f-in">Check in</label>
                <input id="f-in" name="checkIn" type="date" class="form-control" min="<%= todayISO() %>" value="<%= filters.checkIn || '' %>" data-checkin>
            </div>
            <div class="col-lg-2 col-6">
                <label for="f-out">Check out</label>
                <input id="f-out" name="checkOut" type="date" class="form-control" min="<%= todayISO() %>" value="<%= filters.checkOut || '' %>" data-checkout>
            </div>
            <div class="col-lg-1 col-4">
                <label for="f-guests">Guests</label>
                <input id="f-guests" name="guests" type="number" min="1" max="20" class="form-control" value="<%= filters.guests || '' %>">
            </div>
            <div class="col-lg-1 col-4">
                <label for="f-min">Min ₹</label>
                <input id="f-min" name="minPrice" type="number" min="0" class="form-control" value="<%= filters.minPrice || '' %>">
            </div>
            <div class="col-lg-1 col-4">
                <label for="f-max">Max ₹</label>
                <input id="f-max" name="maxPrice" type="number" min="0" class="form-control" value="<%= filters.maxPrice || '' %>">
            </div>
            <div class="col-lg-2 col-12 d-flex gap-2">
                <button class="btn btn-brand flex-fill"><i class="fa-solid fa-magnifying-glass me-1"></i>Search</button>
                <% if (hasFilters) { %>
                    <a href="/listings" class="btn btn-outline-ink" title="Clear all filters"><i class="fa-solid fa-xmark"></i></a>
                <% } %>
            </div>
        </div>
    </form>

    <!-- ===== Results header ===== -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-4 mb-3">
        <div class="fw-semibold">
            <%= listings.length %> <%= listings.length === 1 ? "stay" : "stays" %>
            <% if (nights > 0) { %>
                <span class="text-muted-ll fw-normal">· free for <%= nights %> <%= nights === 1 ? "night" : "nights" %> (<%= formatDate(filters.checkIn) %> – <%= formatDate(filters.checkOut) %>)</span>
            <% } %>
        </div>
        <form action="/listings" method="GET" class="d-flex align-items-center gap-2">
            <% for (const [key, value] of Object.entries(filters)) { if (key !== "sort") { %>
                <input type="hidden" name="<%= key %>" value="<%= value %>">
            <% } } %>
            <label for="sort" class="small text-muted-ll text-nowrap">Sort by</label>
            <select id="sort" name="sort" class="form-select form-select-sm" data-autosubmit>
                <option value="newest" <%= filters.sort === "newest" ? "selected" : "" %>>Newest</option>
                <option value="rating" <%= filters.sort === "rating" ? "selected" : "" %>>Top rated</option>
                <option value="price_asc" <%= filters.sort === "price_asc" ? "selected" : "" %>>Price: low to high</option>
                <option value="price_desc" <%= filters.sort === "price_desc" ? "selected" : "" %>>Price: high to low</option>
            </select>
        </form>
    </div>

    <!-- ===== Results grid ===== -->
    <% if (listings.length === 0) { %>
        <div class="empty-state">
            <i class="fa-solid fa-magnifying-glass-location d-block"></i>
            <h2 class="h5 fw-bold text-dark">No stays match your search</h2>
            <p>Try different dates, a wider price range, or another category.</p>
            <a href="/listings" class="btn btn-outline-ink">Clear filters</a>
        </div>
    <% } else { %>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
            <% for (const listing of listings) { %>
                <div class="col"><%- include("../includes/listing-card.ejs", { listing, nights }) %></div>
            <% } %>
        </div>
    <% } %>
</div>
