<% layout("/layouts/boilerplate") -%>

<div class="container my-4" style="max-width: 760px;">
    <a href="/listings/<%= listing._id %>" class="text-muted-ll small text-decoration-none"><i class="fa-solid fa-arrow-left me-1"></i>Back to listing</a>
    <h1 class="h3 fw-bold mt-2 mb-4">Edit your listing</h1>
    <%- include("../includes/listing-form.ejs", {
        action: `/listings/${listing._id}?_method=PUT`,
        submitLabel: "Save changes",
        listing,
    }) %>
</div>
