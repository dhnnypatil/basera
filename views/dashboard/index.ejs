<% layout("/layouts/boilerplate") -%>
<% const displayStatus = (b) => (b.status === "confirmed" && !b.isUpcoming ? "completed" : b.status); %>

<div class="container my-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Host dashboard</h1>
            <p class="text-muted-ll mb-0">Welcome back, <%= currUser.username %>. Here's how your places are doing.</p>
        </div>
        <a href="/listings/new" class="btn btn-brand"><i class="fa-solid fa-plus me-1"></i>List a new place</a>
    </div>

    <!-- ===== Stats ===== -->
    <div class="row g-3 mb-5">
        <div class="col-md-4">
            <div class="stat-tile">
                <div class="label"><i class="fa-solid fa-house me-1"></i> Listings</div>
                <div class="value"><%= stats.totalListings %></div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-tile">
                <div class="label"><i class="fa-solid fa-calendar-check me-1"></i> Upcoming bookings</div>
                <div class="value"><%= stats.upcomingBookings %></div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-tile">
                <div class="label"><i class="fa-solid fa-indian-rupee-sign me-1"></i> Earnings (confirmed)</div>
                <div class="value"><%= formatPrice(stats.totalEarnings) %></div>
            </div>
        </div>
    </div>

    <!-- ===== Bookings received ===== -->
    <h2 class="h5 fw-bold mb-3">Bookings on your places</h2>
    <% if (bookings.length === 0) { %>
        <p class="text-muted-ll mb-5">No bookings yet. They'll show up here as soon as a guest reserves one of your places.</p>
    <% } else { %>
        <div class="table-responsive mb-5">
            <table class="table table-ll align-middle">
                <thead><tr><th>Listing</th><th>Guest</th><th>Dates</th><th>Guests</th><th>Payout</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    <% for (const booking of bookings) { %>
                        <tr>
                            <td class="fw-semibold"><a href="/listings/<%= booking.listing._id %>" class="text-dark"><%= booking.listing.title %></a></td>
                            <td>
                                <%= booking.guest ? booking.guest.username : "Deleted user" %>
                                <% if (booking.guest) { %><div class="text-muted-ll small"><%= booking.guest.email %></div><% } %>
                            </td>
                            <td class="text-nowrap"><%= formatDate(booking.checkIn) %> – <%= formatDate(booking.checkOut) %></td>
                            <td><%= booking.guests %></td>
                            <td><%= formatPrice(booking.nights * booking.pricePerNight) %></td>
                            <td><span class="status-badge status-<%= displayStatus(booking) %>"><%= displayStatus(booking) %></span></td>
                            <td class="text-end">
                                <% if (booking.isUpcoming) { %>
                                    <form action="/bookings/<%= booking._id %>?_method=DELETE" method="POST" data-confirm="Cancel this guest's booking?">
                                        <button class="btn btn-sm btn-outline-danger">Cancel</button>
                                    </form>
                                <% } %>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    <% } %>

    <!-- ===== Your listings ===== -->
    <h2 class="h5 fw-bold mb-3">Your listings</h2>
    <% if (listings.length === 0) { %>
        <div class="empty-state border rounded-4 py-5">
            <i class="fa-solid fa-house-chimney d-block"></i>
            <h3 class="h6 fw-bold text-dark">You haven't listed a place yet</h3>
            <a href="/listings/new" class="btn btn-brand mt-2">List your first place</a>
        </div>
    <% } else { %>
        <div class="table-responsive">
            <table class="table table-ll align-middle">
                <thead><tr><th>Place</th><th>Category</th><th>Price / night</th><th>Rating</th><th class="text-end">Actions</th></tr></thead>
                <tbody>
                    <% for (const listing of listings) { %>
                        <tr>
                            <td>
                                <a href="/listings/<%= listing._id %>" class="d-flex align-items-center gap-2 text-decoration-none text-dark">
                                    <img src="<%= listing.image.url %>" alt="" class="thumb">
                                    <div>
                                        <div class="fw-semibold"><%= listing.title %></div>
                                        <div class="text-muted-ll small"><%= listing.location %>, <%= listing.country %></div>
                                    </div>
                                </a>
                            </td>
                            <td><%= listing.category %></td>
                            <td><%= formatPrice(listing.price) %></td>
                            <td>
                                <% if (listing.averageRating) { %><i class="fa-solid fa-star"></i> <%= listing.averageRating.toFixed(1) %> <span class="text-muted-ll">(<%= listing.reviews.length %>)</span>
                                <% } else { %><span class="text-muted-ll">No reviews</span><% } %>
                            </td>
                            <td class="text-end text-nowrap">
                                <a href="/listings/<%= listing._id %>/edit" class="btn btn-sm btn-outline-ink">Edit</a>
                                <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" class="d-inline" data-confirm="Delete this listing? Its reviews and bookings will be removed too.">
                                    <button class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>
