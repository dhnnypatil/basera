<% layout("/layouts/boilerplate") -%>
<%
    // A confirmed booking whose check-out has passed is shown as "completed".
    const displayStatus = (b) => (b.status === "confirmed" && !b.isUpcoming ? "completed" : b.status);
%>

<div class="container my-4">
    <h1 class="h3 fw-bold">My trips</h1>
    <p class="text-muted-ll">Manage upcoming stays and look back at past ones.</p>

    <!-- ===== Upcoming ===== -->
    <h2 class="h5 fw-bold mt-4 mb-3">Upcoming</h2>
    <% if (upcoming.length === 0) { %>
        <div class="empty-state border rounded-4 py-5">
            <i class="fa-solid fa-suitcase-rolling d-block"></i>
            <h3 class="h6 fw-bold text-dark">No trips booked... yet!</h3>
            <p>Time to dust off your bags and start planning your next adventure.</p>
            <a href="/listings" class="btn btn-brand">Start searching</a>
        </div>
    <% } else { %>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            <% for (const booking of upcoming) { %>
                <div class="col">
                    <div class="trip-card">
                        <% if (booking.listing) { %>
                            <a href="/listings/<%= booking.listing._id %>"><img src="<%= booking.listing.image.url %>" alt="<%= booking.listing.title %>"></a>
                        <% } %>
                        <div class="body">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <h3 class="h6 fw-bold mb-1"><%= booking.listing ? booking.listing.title : "Listing removed" %></h3>
                                <span class="status-badge status-<%= displayStatus(booking) %>"><%= displayStatus(booking) %></span>
                            </div>
                            <% if (booking.listing) { %><div class="text-muted-ll small mb-2"><%= booking.listing.location %>, <%= booking.listing.country %></div><% } %>
                            <div class="small mb-1"><i class="fa-regular fa-calendar me-2"></i><%= formatDate(booking.checkIn) %> – <%= formatDate(booking.checkOut) %> (<%= booking.nights %> <%= booking.nights === 1 ? "night" : "nights" %>)</div>
                            <div class="small mb-1"><i class="fa-solid fa-user-group me-2"></i><%= booking.guests %> <%= booking.guests === 1 ? "guest" : "guests" %></div>
                            <div class="small mb-3"><i class="fa-solid fa-receipt me-2"></i><b><%= formatPrice(booking.totalPrice) %></b> total</div>
                            <div class="d-flex gap-2 mt-auto">
                                <a href="/bookings/<%= booking._id %>/edit" class="btn btn-sm btn-outline-ink flex-fill">Change dates</a>
                                <form action="/bookings/<%= booking._id %>?_method=DELETE" method="POST" class="flex-fill" data-confirm="Cancel this booking?">
                                    <button class="btn btn-sm btn-outline-danger w-100">Cancel</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
    <% } %>

    <!-- ===== Past & cancelled ===== -->
    <% if (past.length > 0) { %>
        <h2 class="h5 fw-bold mt-5 mb-3">Past & cancelled</h2>
        <div class="table-responsive">
            <table class="table table-ll align-middle">
                <thead><tr><th>Stay</th><th>Dates</th><th>Guests</th><th>Total</th><th>Status</th></tr></thead>
                <tbody>
                    <% for (const booking of past) { %>
                        <tr>
                            <td>
                                <% if (booking.listing) { %>
                                    <a href="/listings/<%= booking.listing._id %>" class="d-flex align-items-center gap-2 text-decoration-none text-dark">
                                        <img src="<%= booking.listing.image.url %>" alt="" class="thumb">
                                        <span class="fw-semibold"><%= booking.listing.title %></span>
                                    </a>
                                <% } else { %>Listing removed<% } %>
                            </td>
                            <td class="text-nowrap"><%= formatDate(booking.checkIn) %> – <%= formatDate(booking.checkOut) %></td>
                            <td><%= booking.guests %></td>
                            <td><%= formatPrice(booking.totalPrice) %></td>
                            <td><span class="status-badge status-<%= displayStatus(booking) %>"><%= displayStatus(booking) %></span></td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>
