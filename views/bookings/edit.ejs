<% layout("/layouts/boilerplate") -%>
<% const listing = booking.listing; %>

<div class="container my-4" style="max-width: 760px;">
    <a href="/bookings" class="text-muted-ll small text-decoration-none"><i class="fa-solid fa-arrow-left me-1"></i>Back to my trips</a>
    <h1 class="h3 fw-bold mt-2 mb-4">Change your booking</h1>

    <div class="d-flex align-items-center gap-3 mb-4 p-3 border rounded-4">
        <img src="<%= listing.image.url %>" alt="" class="thumb" style="width: 96px; height: 72px;">
        <div>
            <div class="fw-bold"><%= listing.title %></div>
            <div class="text-muted-ll small"><%= listing.location %>, <%= listing.country %> · <%= formatPrice(booking.pricePerNight) %> / night</div>
        </div>
    </div>

    <form action="/bookings/<%= booking._id %>?_method=PUT" method="POST" class="needs-validation" novalidate>
        <div class="row">
            <div class="col-md-5 mb-3">
                <label for="checkIn" class="form-label">Check-in</label>
                <input id="checkIn" name="booking[checkIn]" type="date" class="form-control" min="<%= todayISO() %>" value="<%= toDateInputValue(booking.checkIn) %>" required data-checkin>
            </div>
            <div class="col-md-5 mb-3">
                <label for="checkOut" class="form-label">Check-out</label>
                <input id="checkOut" name="booking[checkOut]" type="date" class="form-control" min="<%= todayISO() %>" value="<%= toDateInputValue(booking.checkOut) %>" required data-checkout>
            </div>
            <div class="col-md-2 mb-3">
                <label for="guests" class="form-label">Guests</label>
                <input id="guests" name="booking[guests]" type="number" class="form-control" min="1" max="<%= listing.maxGuests %>" value="<%= booking.guests %>" required>
            </div>
        </div>
        <p class="text-muted-ll small">The total is recalculated at <%= formatPrice(booking.pricePerNight) %> per night (the price when you booked) plus the service fee.</p>
        <button class="btn btn-brand px-4">Save changes</button>
    </form>
</div>
